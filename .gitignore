node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example
.openclaude-profile.json
reports/

# Python bytecode cache (python-bridge/)
__pycache__/
*.pyc
*.pyo

# python-bridge server logs — machine-specific paths/username, no secrets
# observed in practice, but no reason to let them get swept into a commit
# either (flagged in the 2026-08-12 security review)
python-bridge/*.log

# python-bridge's dedicated CUDA venv (2026-08-12) — several GB of
# installed packages incl. a CUDA torch build, never belongs in git; see
# python-bridge/README.md for how to rebuild it from requirements.txt
python-bridge/venv/

# Local MCP server config — real absolute paths, machine-specific
.mcp.json
!.mcp.json.example

# synaptic-memory (mempalace + graphify) — local paths, gitignored per its own convention
mempalace.project.json
mempalace.yaml
graphify-out/

# Personal/local Claude Code settings (machine-specific paths, permission grants)
.claude/settings.local.json

# Transient hook state (subagent-gate circuit-breaker counters)
.claude/hooks/.subagent-gate-state.json
